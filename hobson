        fi
        # Normalize: kokoro-realtime → kokoro
        case "$setup_engine" in
            kokoro|kokoro-realtime)
                VENV_DIR="$SCRIPT_DIR/venvs/kokoro"
                MODEL_DIR="$SCRIPT_DIR/models"
