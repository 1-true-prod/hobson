                if pid=$(daemon_pid "$DAEMON_PID_FILE"); then
                    health=$(daemon_health "$DAEMON_PORT")
                    if [[ -n "$health" ]]; then
                        uptime=$(echo "$health" | python3 -c "import sys,json; print(json.load(sys.stdin).get('uptime','?'))" 2>/dev/null || echo "?")
                        echo -e "Daemon:  ${GREEN}running${NC} (pid $pid, uptime ${uptime}s)"
                    else
                        echo -e "Daemon:  ${YELLOW}pid $pid but not responding${NC}"
                    fi
                else
                    echo -e "Daemon:  ${YELLOW}not running${NC}"
                fi
                ;;
            *)
                echo "Usage: hobson daemon {start|stop|status}"
                exit 1
                ;;
        esac
