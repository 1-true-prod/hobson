        for pdir in "$personalities_dir"/*/; do
            pjson="$pdir/personality.json"
            [[ -f "$pjson" ]] || continue
            pname=$(python3 -c "import json; print(json.load(open('$pjson'))['name'])" 2>/dev/null) || continue
            pdesc=$(python3 -c "import json; d=json.load(open('$pjson')); print(d.get('display_name','') + ' — ' + d.get('description',''))" 2>/dev/null) || continue
            _PICK_OPTIONS+=("$pname")
            _PICK_DESCS+=("$pdesc")
        done

        if [[ ${#_PICK_OPTIONS[@]} -eq 0 ]]; then
            echo -e "${RED}No personalities found in $personalities_dir${NC}"
            exit 1
        fi

        if [[ -z "$new_personality" ]]; then
            current=$(get_personality)
            sel=0
            for i in "${!_PICK_OPTIONS[@]}"; do
                [[ "${_PICK_OPTIONS[$i]}" == "$current" ]] && sel=$i
            done
            echo "Current: $current"
            echo ""
            _pick_menu "$sel"
            new_personality="$PICK_RESULT"
        fi

        # Check if argument matches a known personality name
        is_known_personality=false
        for _p in "${_PICK_OPTIONS[@]}"; do
            [[ "$_p" == "$new_personality" ]] && is_known_personality=true && break
        done

        if ! $is_known_personality; then
            echo -e "${RED}Unknown personality: $new_personality${NC}"
            echo "Available: ${_PICK_OPTIONS[*]}"
            exit 1
        else
            python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        config = json.load(f)
except:
    config = {}
config['personality'] = '$new_personality'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')
"
            echo -e "${GREEN}Personality set to: $new_personality${NC}"

            # Warn about cache invalidation for chatterbox
            engine=$(get_engine)
            if [[ "$engine" == "chatterbox" ]]; then
                cache_dir="$HOME/.claude/voice-cache-chatterbox"
                if [[ -d "$cache_dir" ]]; then
                    count=$(find "$cache_dir" -type f -name "*.wav" 2>/dev/null | wc -l | tr -d ' ')
                    if [[ "$count" -gt 0 ]]; then
                        echo -e "${YELLOW}Note: $count cached WAVs were generated with a different personality's templates.${NC}"
                        echo -e "${YELLOW}Run 'hobson cache-gen --force' to regenerate.${NC}"
                    fi
                fi
            fi
        fi
        ;;

    preset)
        presets_file="$SCRIPT_DIR/scripts/presets.json"
        if [[ ! -f "$presets_file" ]]; then
            echo -e "${RED}Presets file not found: $presets_file${NC}"
            exit 1
        fi

        new_preset="${1:-}"

        # Load preset names and descriptions
        _PICK_OPTIONS=()
        _PICK_DESCS=()
        while IFS='|' read -r key desc; do
            _PICK_OPTIONS+=("$key")
            _PICK_DESCS+=("$desc")
        done < <(python3 -c "
import json
with open('$presets_file') as f:
    presets = json.load(f)
for k, v in presets.items():
    print(f\"{k}|{v.get('display_name',k)} — {v.get('description','')}\")
" 2>/dev/null)

        if [[ ${#_PICK_OPTIONS[@]} -eq 0 ]]; then
            echo -e "${RED}No presets found${NC}"
            exit 1
        fi

        if [[ -z "$new_preset" ]]; then
            echo "Choose a preset:"
            echo ""
            _pick_menu 0
            new_preset="$PICK_RESULT"
        fi

        # Apply preset: deep-merge preset config into current config (preserves volume, etc.)
        python3 -c "
import json, sys
presets_file = '$presets_file'
config_file = '$CONFIG_FILE'
preset_name = '$new_preset'

with open(presets_file) as f:
    presets = json.load(f)

if preset_name not in presets:
    print(f'Unknown preset: {preset_name}', file=sys.stderr)
    print(f'Available: {', '.join(presets.keys())}', file=sys.stderr)
    sys.exit(1)

preset_config = presets[preset_name]['config']

try:
    with open(config_file) as f:
        config = json.load(f)
except:
    config = {}

# Deep merge: preset values override, but preserve keys not in preset
for key, val in preset_config.items():
    if isinstance(val, dict) and key in config and isinstance(config[key], dict):
        config[key] = {**config[key], **val}
    else:
        config[key] = val

with open(config_file, 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')
"
        echo -e "${GREEN}Applied preset: $new_preset${NC}"

        # Show what was set
        engine=$(get_engine)
        personality=$(get_personality)
        echo -e "  Engine:      $engine"
        echo -e "  Personality: $personality"

        # Warn if engine needs setup
        case "$engine" in
            kokoro-realtime)
                if [[ ! -f "$SCRIPT_DIR/venvs/kokoro/bin/python3" ]]; then
                    echo -e "  ${YELLOW}Note: kokoro-realtime needs setup. Run: hobson setup kokoro${NC}"
                fi
                ;;
            chatterbox)
                if [[ ! -f "$SCRIPT_DIR/venvs/chatterbox/bin/python3" ]]; then
                    echo -e "  ${YELLOW}Note: chatterbox needs setup first.${NC}"
                fi
                ;;
        esac
        ;;

    recap)
        python3 "$SCRIPT_DIR/scripts/recap.py" "$@"
        ;;

    say)
        # Read text aloud on demand: arguments, -f FILE, or standard input.
        # Returns when the last passage has played (scripts/read_aloud.py).
        python3 "$SCRIPT_DIR/scripts/read_aloud.py" "$@"
        ;;

    update|upgrade)
        # A checkout on a branch fast-forwards; one pinned to a tag (detached
        # HEAD) stays put. Either way the installer then refreshes the hooks
        # and keeps every setting.
        if ! git -C "$SCRIPT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
            echo -e "${RED}$SCRIPT_DIR is not a git checkout.${NC} Re-run the install one-liner from the README."
            exit 1
        fi
        if [[ -n "$(git -C "$SCRIPT_DIR" status --porcelain --untracked-files=no)" ]]; then
            echo -e "${RED}$SCRIPT_DIR has local changes.${NC} Commit or stash them, then re-run."
            exit 1
        fi
        before=$(git -C "$SCRIPT_DIR" rev-parse --short HEAD)
        if git -C "$SCRIPT_DIR" symbolic-ref -q HEAD >/dev/null; then
            if ! git -C "$SCRIPT_DIR" pull --ff-only --quiet; then
                echo -e "${RED}Could not fast-forward $SCRIPT_DIR.${NC} Re-run the install one-liner to reset it."
                exit 1
            fi
        else
            echo "Pinned to $(git -C "$SCRIPT_DIR" describe --tags --always); to move, re-run the installer with HOBSON_REF=<tag>."
        fi
        after=$(git -C "$SCRIPT_DIR" rev-parse --short HEAD)
        if [[ "$before" == "$after" ]]; then
            echo "Already up to date ($after)."
        else
            echo "Updated $before → $after:"
            git -C "$SCRIPT_DIR" log -n 15 --oneline --no-decorate "$before..$after" | sed 's/^/  /'
        fi
        "$SCRIPT_DIR/install.sh" --update
        ;;

    uninstall)
        "$SCRIPT_DIR/uninstall.sh" "$@"
        ;;

    help|--help|-h)
        echo "Hobson — a synthetic butler for Claude Code"
        echo ""
        echo "Usage:"
        echo "  hobson status              Show current engine and config"
        echo "  hobson on                  Enable voice notifications"
        echo "  hobson off [duration]      Disable voice, optionally timed: 45, 90s, 30m, 2h"
        echo "                              (recurring window: set quiet_hours: [start,end] in config)"
        echo "  hobson use [engine]        Switch engine (say/kokoro-realtime/chatterbox)"
        echo "  hobson personality [name]  Switch voice personality"
        echo "  hobson preset [name]       Apply a configuration preset"
        echo "  hobson events              Configure which events trigger voice"
        echo "  hobson commentary on|off   Toggle running commentary"
        echo "  hobson commentary verbosity [terse|normal|chatty|anomaly]  Set commentary verbosity"
        echo "  hobson commentary chattiness [0-1]  How much commentary Jev lets through (decider on)"
        echo "  hobson volume [0-10]       Get or set playback volume"
        echo "  hobson voice [name]        Switch Kokoro voice"
        echo "  hobson test                Play a test bark"
        echo "  hobson say [TEXT|-f FILE]  Read text aloud (or piped in), a passage at a time"
        echo "  hobson recap [minutes]     Speak a summary of recent activity (default 10m)"
        echo "  hobson presence [status|on|off|mode|greetings|waves|phone|look|setup]  Whether anyone is listening"
        echo "  hobson face [status|on|off|test]  The window where Hobson says each line"
        echo "  hobson ask [status|recap|failed]  What needs me, what have you been doing, what failed"
        echo "  hobson lines [category]    Show voice lines"
        echo "  hobson monitor             Watch bark activity in real time"
        echo "  hobson stats               Show what was spoken, queued, and suppressed"
        echo "  hobson doctor              Run diagnostics"
        echo "  hobson config show|reset   Show or reset configuration"
        echo "  hobson cache-gen [--force] Generate voice cache for current engine"
        echo "  hobson setup               The setup wizard: voice, brain, Jev, presence, phone"
        echo "  hobson setup kokoro|pocket-tts|chatterbox  Install one engine's venv + models"
        echo "  hobson daemon start|stop   Manage TTS daemon (kokoro)"
        echo "  hobson version             Print the version"
        echo "  hobson update              Pull the latest hobson and refresh its hooks"
        echo "  hobson uninstall [--yes]   Remove hobson (--yes: everything, no prompts)"
        ;;

    *)
        echo "Unknown command: $cmd"
        echo "Run 'hobson help' for usage."
        exit 1
        ;;
esac
