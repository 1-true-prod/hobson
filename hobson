#!/usr/bin/env bash
set -euo pipefail

# hobson CLI — manage voice notifications for Claude Code
#
# Usage:
#   hobson status              Show current engine and config
#   hobson use <engine>        Switch TTS engine
#   hobson mute                Mute voice notifications
#   hobson unmute              Unmute voice notifications
#   hobson test                Play a test bark
#   hobson say [TEXT|-f FILE]  Read text aloud (or standard input), one voice at a time
#   hobson recap [minutes]     Speak a summary of recent activity (default 10m)
#   hobson cache-gen           Generate voice cache for current engine
#   hobson cache-gen --force   Regenerate entire cache
#   hobson voice [name]        Switch Kokoro voice
#   hobson daemon start|stop|status  Manage realtime daemon

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")" && pwd)"
CONFIG_FILE="$HOME/.claude/hobson.json"

# Hobson was claude-bark once: take over its config the first time the CLI
# runs without one.
if [[ ! -f "$CONFIG_FILE" && -e "$HOME/.claude/claude-bark.json" ]]; then
    python3 - "$SCRIPT_DIR/scripts" <<'PY' 2>/dev/null || true
import sys
sys.path.insert(0, sys.argv[1])
from home import migrate_legacy_state
for moved in migrate_legacy_state():
    print(f"Moved ~/.claude/{moved}")
PY
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

get_engine() {
    python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        print(json.load(f).get('engine', 'say'))
except:
    print('say')
" 2>/dev/null
}

get_personality() {
    python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        print(json.load(f).get('personality', 'hobson'))
except:
    print('hobson')
" 2>/dev/null
}

# Whether process $1 is the daemon script $2: a pid file a crash left behind
# can name a pid some unrelated process has since been given.
_is_daemon() {
    [[ "$(ps -p "$1" -o command= 2>/dev/null)" == *"$(basename "$2")"* ]]
}

# Whether process $1 runs the daemon script at path $2, this checkout's. A
# pid file is this HOME's, so its pid needs only _is_daemon; a listener on
# the port may be another checkout's daemon (the sandbox's, a worktree's),
# which is not this install's to kill.
_is_this_daemon() {
    [[ "$(ps -ww -p "$1" -o command= 2>/dev/null)" == *"$2"* ]]
}

daemon_pid() {
    local pid_file="$1"
    if [[ -f "$pid_file" ]]; then
        local pid
        pid=$(cat "$pid_file" 2>/dev/null)
        # A daemon's files are named after its script (tts_daemon.py).
        if [[ -n "$pid" ]] && _is_daemon "$pid" "$(basename "${pid_file%.pid}").py"; then
            echo "$pid"
            return 0
        fi
    fi
    return 1
}

daemon_health() {
    local port="$1"
    curl -s --max-time 2 "http://127.0.0.1:$port/health" 2>/dev/null
}

# Ask a TTS daemon to stop, with the token it wrote beside its pid file
# (tts_daemon.py). Without the token it refuses, and the caller's kill stops it.
daemon_shutdown() {
    local port="$1" token_file="$2" token
    token=$(cat "$token_file" 2>/dev/null || true)
    curl -s --max-time 2 -X POST -H "X-Hobson-Token: $token" \
        "http://127.0.0.1:$port/shutdown" >/dev/null 2>&1 || true
}

# The daemon engine $1 runs, as the engine itself describes it
# (DaemonEngine.cli_lines): its port, files and start command, never a copy
# kept here. Fails for an engine with no daemon.
_daemon_vars_for_engine() {
    local line found=false
    DAEMON_NAME="$1"
    DAEMON_ARGV=()
    DAEMON_POLL_SLEEP=0.25
    while IFS= read -r line; do
        found=true
        case "$line" in
            PORT=*)       DAEMON_PORT="${line#PORT=}" ;;
            PID_FILE=*)   DAEMON_PID_FILE="${line#PID_FILE=}" ;;
            TOKEN_FILE=*) DAEMON_TOKEN_FILE="${line#TOKEN_FILE=}" ;;
            LOG=*)        DAEMON_LOG="${line#LOG=}" ;;
            VENV=*)       DAEMON_VENV="${line#VENV=}" ;;
            SCRIPT=*)     DAEMON_SCRIPT="${line#SCRIPT=}" ;;
            POLLS=*)      DAEMON_START_POLLS="${line#POLLS=}" ;;
            ARG=*)        DAEMON_ARGV+=("${line#ARG=}") ;;
        esac
    done < <(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
import hobson
from engines.daemon import DaemonEngine
from home import load_config
cls = hobson.engine_class(sys.argv[2])
if cls is not None and issubclass(cls, DaemonEngine):
    print("\n".join(cls(load_config()).cli_lines()))
' "$SCRIPT_DIR/scripts" "$1")
    [[ "$found" == true ]]
}

# ── Shared arrow-key picker ────────────────────────────────────────
# Set _PICK_OPTIONS[@] and _PICK_DESCS[@] before calling.
# After return, PICK_RESULT holds the selected option string.
_pick_menu() {
    local sel="${1:-0}"
    local DIM='\033[2m'
    local max_len=0
    for opt in "${_PICK_OPTIONS[@]}"; do
        (( ${#opt} > max_len )) && max_len=${#opt}
    done
    local col=$((max_len + 2))

    tput civis 2>/dev/null || true  # TERM=dumb: tput fails, set -e would end the menu
    trap 'tput cnorm 2>/dev/null || true' EXIT

    _pick_draw() {
        [[ "${1:-}" == "r" ]] && printf '\033[%dA' "${#_PICK_OPTIONS[@]}"
        for i in "${!_PICK_OPTIONS[@]}"; do
            if [[ $i -eq $sel ]]; then
                printf "  ${GREEN}▸ %-${col}s${NC} ${DIM}%s${NC}\n" "${_PICK_OPTIONS[$i]}" "${_PICK_DESCS[$i]:-}"
            else
                printf "    %-${col}s ${DIM}%s${NC}\n" "${_PICK_OPTIONS[$i]}" "${_PICK_DESCS[$i]:-}"
            fi
        done
    }
    _pick_draw
    while true; do
        IFS= read -rsn1 key
        case "$key" in
            $'\x1b')
                read -rsn2 rest
                case "$rest" in
                    '[A') ((sel > 0)) && sel=$((sel - 1)) ;;
                    '[B') ((sel < ${#_PICK_OPTIONS[@]}-1)) && sel=$((sel + 1)) ;;
                esac
                _pick_draw r
                ;;
            '')
                break
                ;;
        esac
    done
    tput cnorm 2>/dev/null || true
    PICK_RESULT="${_PICK_OPTIONS[$sel]}"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    version|--version|-v|-V)
        cat "$SCRIPT_DIR/VERSION"
        exit 0
        ;;

    status)
        engine=$(get_engine)
        personality=$(get_personality)
        voice=$(python3 -c "
