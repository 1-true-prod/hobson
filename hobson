                    echo "Creating chatterbox venv (Python 3.11)..."
                    uv venv --python 3.11 "$VENV_DIR"
                fi
                echo "Installing chatterbox-tts and dependencies (this may take a while)..."
                uv pip install --python "$VENV_DIR/bin/python3" chatterbox-tts torch torchaudio soundfile resemble-perth || {
                    echo -e "${RED}Failed to install chatterbox-tts. Check your internet connection.${NC}"
                    exit 1
                }
                echo -e "${GREEN}Chatterbox dependencies installed.${NC}"
                echo ""

                PERSONALITY=$(get_personality)
                USER_MODELS="$HOME/.claude/models"

                _found_ref=$(chatterbox_reference)

                echo "Setting up Chatterbox voice cloning..."
                echo ""
                if [[ -n "$_found_ref" ]]; then
                    echo -e "Current reference audio: ${GREEN}$_found_ref${NC}"
                    echo ""
                else
                    echo -e "${YELLOW}No reference audio found.${NC}"
                    echo ""
                fi

                # Accept path as $2 arg or open native file picker
                if [[ -n "${2:-}" ]]; then
                    REF_AUDIO_PATH="${2/#\~/$HOME}"
                    if [[ ! -f "$REF_AUDIO_PATH" ]]; then
                        echo -e "${RED}File not found: $REF_AUDIO_PATH${NC}"
                        exit 1
                    fi
                else
                    echo "Chatterbox needs a short audio clip (10–30s) to clone your voice."
                    echo "Opening file picker... (wav, mp3, flac, ogg, m4a)"
                    REF_AUDIO_PATH=$(osascript -e 'POSIX path of (choose file with prompt "Select reference audio for voice cloning" of type {"wav", "mp3", "flac", "ogg", "m4a"})' 2>/dev/null)
                    if [[ -z "$REF_AUDIO_PATH" ]]; then
                        echo "Cancelled."
