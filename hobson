                    HF_BASE="https://huggingface.co/hexgrad/Kokoro-82M-v1.0-ONNX/resolve/main"
                    # Try hf_hub_download first, fall back to curl
                    "$VENV_DIR/bin/python3" -c "
from huggingface_hub import hf_hub_download
hf_hub_download('hexgrad/Kokoro-82M-v1.0-ONNX', 'kokoro-v1.0.int8.onnx', local_dir='$MODEL_DIR')
hf_hub_download('hexgrad/Kokoro-82M-v1.0-ONNX', 'voices-v1.0.bin', local_dir='$MODEL_DIR')
print('Models downloaded.')
" 2>/dev/null || {
                        echo "hf_hub_download failed, trying curl..."
                        curl -fL -o "$MODEL_DIR/kokoro-v1.0.int8.onnx" "$HF_BASE/kokoro-v1.0.int8.onnx" && \
                        curl -fL -o "$MODEL_DIR/voices-v1.0.bin" "$HF_BASE/voices-v1.0.bin" && \
                        echo "Models downloaded via curl."
                    } || {
                        echo -e "${YELLOW}Auto-download failed. Download manually from:${NC}"
                        echo "  https://huggingface.co/hexgrad/Kokoro-82M-v1.0-ONNX"
                        echo "  Place kokoro-v1.0.int8.onnx and voices-v1.0.bin in $MODEL_DIR/"
                    }
                else
                    echo -e "${GREEN}Models already present${NC}"
                fi
                echo -e "${GREEN}Kokoro setup complete. Run: hobson daemon start${NC}"
                ;;
            chatterbox)
                VENV_DIR="$SCRIPT_DIR/venvs/chatterbox"
                if ! command -v uv &>/dev/null; then
                    echo -e "${RED}uv is required to create venvs. Install: curl -LsSf https://astral.sh/uv/install.sh | sh${NC}"
                    exit 1
                fi
                # chatterbox-tts requires Python 3.11 — resemble-perth has no 3.12+ wheel
                if [[ -d "$VENV_DIR" ]]; then
                    _cur_py=$("$VENV_DIR/bin/python3" --version 2>/dev/null || echo "")
                    if [[ "$_cur_py" != *"3.11"* ]]; then
                        echo "Recreating chatterbox venv with Python 3.11 (resemble-perth requires it)..."
