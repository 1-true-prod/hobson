                printf "  %s  %b  ${DIM}⊘ %s${NC}\n" "$ts" "$engine_tag" "$rest"

            # ── Daemon lifecycle ───────────────────────────────────
            elif [[ "$rest" == daemon:\ * ]]; then
                printf "  %s  %b  ${DIM}%s${NC}\n" "$ts" "$engine_tag" "$rest"

            # ── Fallthrough (old format or unknown) ────────────────
            else
                printf "  ${DIM}%s${NC}\n" "$line"
            fi
        done
        ;;

