            echo "Current engine: $engine"
            exit 1
        fi
        case "$subcmd" in
            start)
                if pid=$(daemon_pid "$DAEMON_PID_FILE"); then
                    echo -e "${YELLOW}Daemon already running (pid $pid)${NC}"
                    exit 0
                fi
                if [[ ! -f "$DAEMON_VENV" ]]; then
