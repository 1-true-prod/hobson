                    echo -e "Run: ${YELLOW}hobson setup $engine_base${NC}"
                    exit 1
                fi
                echo "Starting the $DAEMON_NAME daemon..."
                # The engine's own command, so the daemon starts as a hook would
                # start it; any flags given here come after.
                "${DAEMON_ARGV[@]}" "$@" &
                disown
                for i in $(seq 1 "$DAEMON_START_POLLS"); do
                    sleep "$DAEMON_POLL_SLEEP"
                    if health=$(daemon_health "$DAEMON_PORT"); then
                        pid=$(daemon_pid "$DAEMON_PID_FILE") || pid="?"
                        echo -e "${GREEN}Daemon started (pid $pid)${NC}"
                        exit 0
                    fi
                done
                echo -e "${RED}Daemon failed to start (check $DAEMON_LOG)${NC}"
                exit 1
